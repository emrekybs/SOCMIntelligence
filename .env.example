# SOCMIntelligence environment variables
# Usage: cp .env.example .env  ->  fill in the values  ->  uvicorn server:app

# YouTube Data API v3 key (required for the YouTube module)
# https://console.cloud.google.com -> APIs & Services -> YouTube Data API v3 -> Credentials
YOUTUBE_API_KEY=

# Number of scans running simultaneously (default: 4)
# SOCMINT_WORKERS=4
